# CineTrack API Configurations
PROJECT_NAME="CineTrack API"
ENVIRONMENT="local"

# Database Configuration
# SQLite fallback is set in code, but PostgreSQL with asyncpg is the default.
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/cinetrack"

# CORS Configuration (JSON array of strings)
CORS_ORIGINS='["http://localhost:8000", "http://localhost:3000", "http://localhost:5000", "http://localhost"]'

# Authentication
SECRET_KEY="change_me_to_a_secure_random_key_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=11520
